// Source-built replacement for the ABI-incompatible prebuilt Dolby audio
// Codec2 service. The init rc and VINTF manifest come from
// vendor/oneplus/dolby (config.mk copy + DEVICE_MANIFEST_FILE).
cc_binary {
    name: "vendor.dolby.media.c2@1.0-service",
    soc_specific: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    srcs: ["service.cpp"],
    shared_libs: [
        "android.hardware.media.c2@1.0",
        "libbase",
        "libbinder",
        "libcodec2_hidl@1.0",
        "libdl",
        "libhidlbase",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
